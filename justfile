# Velocity fork, compiled through buck2. Run inside the devshell (`direnv exec . just ...`).

root := justfile_directory()

_default:
    @just --list --unsorted

# Records the identity of the JDK on PATH into .buckconfig.local, so it is part of every action
# key without an absolute /nix/store path ending up in any argv.
bootstrap:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v javac >/dev/null || { echo "bootstrap: javac not on PATH -- run inside 'nix develop'" >&2; exit 1; }
    command -v zig >/dev/null || { echo "bootstrap: zig not on PATH -- run inside 'nix develop'" >&2; exit 1; }
    jdk_version="$(java -version 2>&1 | head -1 | sed 's/.*version "\([^"]*\)".*/\1/')"
    zig_version="$(zig version)"
    { printf '# GENERATED by `just bootstrap` -- do not edit, do not commit.\n'
      printf '[java]\n  toolchain_version = jdk %s\n' "$jdk_version"
      printf '[zig]\n  toolchain_version = zig %s\n' "$zig_version"
    } > .buckconfig.local
    echo "wrote .buckconfig.local (jdk $jdk_version, zig $zig_version)"

# compile every module, and mccrypt
build:
    @buck2 build //api:lib //native:lib //proxy:lib '//mccrypt:mccrypt[cdylib]' //mccrypt:bench --show-simple-output

# Build mccrypt for every slot in native/src/main/resources and install it there, which is what
# mccrypt/build-native.sh did with cargo + cargo-zigbuild. The Linux slots are cross-built on any
# host; the macOS slot only on a Mac (no Apple SDK anywhere else).
natives:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{root}}"
    res=native/src/main/resources
    cdylib='//mccrypt:mccrypt[cdylib]'
    buck2 build "$cdylib" --target-platforms //platforms:linux-x86_64  --out "$res/linux_x86_64/velocity-cipher.so"
    buck2 build "$cdylib" --target-platforms //platforms:linux-aarch64 --out "$res/linux_aarch64/velocity-cipher.so"
    if [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ]; then
        buck2 build "$cdylib" --target-platforms //platforms:macos-arm64 --out "$res/macos_arm64/velocity-cipher.dylib"
    else
        echo "natives: not a Mac, leaving $res/macos_arm64 as is"
    fi
    ls -la "$res"/*/velocity-cipher.*

# mccrypt/Cargo.lock -> third-party/rust/BUCK (see reindeer.toml). Re-run after changing
# mccrypt's dependencies; the diff of the generated file is the review.
lock-rust:
    @reindeer buckify

# Ask gradle -- the resolver upstream actually uses -- for the resolved graph of every module,
# then regenerate third-party/jvm/{BUCK,classpaths.bzl} from it. Re-run after an upstream merge
# touches gradle/libs.versions.toml or a build.gradle.kts; the diff of the generated files is
# the review.
lock:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{root}}"
    ./gradlew -q -I tools/dumpdeps.init.gradle.kts \
        :velocity-api:dumpDeps :velocity-native:dumpDeps :velocity-proxy:dumpDeps :deprecated-configurate3:dumpDeps
    python3 tools/gen-third-party.py build/deps third-party/jvm
