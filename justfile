# Velocity fork, compiled through buck2. Run inside the devshell (`direnv exec . just ...`).

root := justfile_directory()

_default:
    @just --list --unsorted

# Records the identity of the JDK on PATH into .buckconfig.local, so it is part of every action
# key without an absolute /nix/store path ending up in any argv.
bootstrap:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v javac >/dev/null || { echo "bootstrap: javac not on PATH -- run inside 'nix develop'" >&2; exit 1; }
    jdk_version="$(java -version 2>&1 | head -1 | sed 's/.*version "\([^"]*\)".*/\1/')"
    { printf '# GENERATED by `just bootstrap` -- do not edit, do not commit.\n'
      printf '[java]\n  toolchain_version = jdk %s\n' "$jdk_version"
    } > .buckconfig.local
    echo "wrote .buckconfig.local (jdk $jdk_version)"

# compile every module
build:
    @buck2 build //api:lib //native:lib //proxy:lib --show-simple-output

# Ask gradle -- the resolver upstream actually uses -- for the resolved graph of every module,
# then regenerate third-party/jvm/{BUCK,classpaths.bzl} from it. Re-run after an upstream merge
# touches gradle/libs.versions.toml or a build.gradle.kts; the diff of the generated files is
# the review.
lock:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{root}}"
    ./gradlew -q -I tools/dumpdeps.init.gradle.kts \
        :velocity-api:dumpDeps :velocity-native:dumpDeps :velocity-proxy:dumpDeps :deprecated-configurate3:dumpDeps
    python3 tools/gen-third-party.py build/deps third-party/jvm
