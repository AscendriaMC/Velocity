# mccrypt through buck2. The shipped artifact is the cdylib: `buck2 build //mccrypt:mccrypt[cdylib]`.
# Third-party crates come from third-party/rust/BUCK, generated by reindeer from Cargo.lock.
#
# Flags mirror [profile.dist] in Cargo.toml (opt-level 3 is set once, on toolchains//:rust, so
# every crate gets it). -Clto=fat does its work at the cdylib link, over mccrypt's, jni-sys's and
# std's bitcode; on the rlib it only means "keep the bitcode". Cargo.toml stays the source of
# truth for `cargo test` / `cargo bench`.

rust_library(
    name = "mccrypt",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**"]),
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = ["//third-party/rust:jni-sys"],
    rustc_flags = [
        "-Ccodegen-units=1",
        "-Clto=fat",
        "-Cpanic=abort",
        "-Cstrip=symbols",
    ],
    visibility = ["PUBLIC"],
)

rust_binary(
    name = "bench",
    srcs = ["src/bin/bench.rs"],
    crate_root = "src/bin/bench.rs",
    edition = "2021",
    deps = [":mccrypt"],
    # Same strategy as the library: an unwinding binary cannot link a panic=abort rlib.
    rustc_flags = ["-Cpanic=abort"],
)
