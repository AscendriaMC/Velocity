# Toolchains the bundled prelude's rules (and jvm//'s) look up by these exact names.
#
# Every tool is a package of nix/flake.nix, built by buck2.nix's flake.package on whichever
# machine runs the action -- this Mac for the local execution platform, a remote worker for
# the remote ones -- so the same BUCK file serves both, and a worker needs nothing but nix.
load("@jvm//rules:java.bzl", "java_toolchain")
load("@nix//:flake.bzl", "flake")
load("@nix//toolchains:python.bzl", "nix_python_bootstrap_toolchain")
load("@nix//toolchains:rust.bzl", "nix_rust_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@root//bzl:nix_cxx.bzl", "nix_cxx_toolchain")
load("@root//bzl:zig.bzl", "zig_cxx_toolchain")

# ---- packages ------------------------------------------------------------------------------
# local_only = False: the nix build may run on a remote worker. That is only sound because the
# workers have nix and a persistent store.
#
# A package is built for the platform of the machine that will run it (its target configuration
# is the consumer's execution platform), and nix can only build that on a machine of the same
# platform. Exec deps pick their own execution platform -- first compatible -- so without this
# the aarch64-darwin rustc would be scheduled onto a Linux worker.
_EXEC_LIKE_TARGET = select({
    "prelude//os:linux": select({
        "prelude//cpu:arm64": ["prelude//os/constraints:linux", "prelude//cpu/constraints:arm64"],
        "prelude//cpu:x86_64": ["prelude//os/constraints:linux", "prelude//cpu/constraints:x86_64"],
    }),
    "prelude//os:macos": select({
        "prelude//cpu:arm64": ["prelude//os/constraints:macos", "prelude//cpu/constraints:arm64"],
        "prelude//cpu:x86_64": ["prelude//os/constraints:macos", "prelude//cpu/constraints:x86_64"],
    }),
})

flake.package(
    name = "jdk",
    binaries = ["java", "javac", "jar"],
    exec_compatible_with = _EXEC_LIKE_TARGET,
    local_only = False,
    wrappers = True,
    path = "@root//nix:flake",
)

flake.package(
    name = "rustc",
    binaries = ["rustdoc", "cargo"],
    binary = "rustc",
    exec_compatible_with = _EXEC_LIKE_TARGET,
    local_only = False,
    wrappers = True,
    package = "rust",
    path = "@root//nix:flake",
)

flake.package(
    name = "zig",
    binary = "zig",
    exec_compatible_with = _EXEC_LIKE_TARGET,
    local_only = False,
    wrappers = True,
    path = "@root//nix:flake",
)

flake.package(
    name = "nix_cc",
    binaries = ["ar", "c++", "cc", "nm", "objcopy", "ranlib", "strip"],
    exec_compatible_with = _EXEC_LIKE_TARGET,
    local_only = False,
    package = "cxx",
    path = "@root//nix:flake",
    wrappers = True,
)

flake.package(
    name = "python",
    binary = "python3",
    exec_compatible_with = _EXEC_LIKE_TARGET,
    local_only = False,
    wrappers = True,
    path = "@root//nix:flake",
)

# ---- toolchains ----------------------------------------------------------------------------

java_toolchain(
    name = "java",
    java = ":jdk[java]",
    javac = ":jdk[javac]",
    jar = ":jdk[jar]",
    visibility = ["PUBLIC"],
)

# rustc_target_triple defaults to a select on the target platform's os/cpu, which is what makes
# //platforms:linux-* produce Linux code with no per-target configuration here. The minimal
# rust profile has no clippy; rustc stands in for the attribute the rule insists on.
nix_rust_toolchain(
    name = "rust",
    clippy = ":rustc",
    default_edition = "2021",
    rustc = ":rustc",
    rustdoc = ":rustc[rustdoc]",
    # The only crate that matters for speed is mccrypt's kernels; the rest is JNI typedefs and
    # a proc macro. Set here so it is one flag, not one per target.
    rustc_flags = ["-Copt-level=3"],
    visibility = ["PUBLIC"],
)

# The C toolchain is what rustc links through (-Clinker=), and there are two kinds of link:
#
#   * the shipping cdylibs, //platforms:{linux-*,macos-*} (constraint :portable): `zig cc
#     -target <triple>`, glibc 2.17 on Linux -- the floor build-native.sh used with cargo-zigbuild
#     -- so the artifacts run on any machine of that os, and cross-linked from any host, so a
#     Linux worker produces the macOS slot too and a build can be entirely remote;
#   * everything else -- build scripts, proc macros, bench -- links with nix's cc for the
#     platform it runs on. A worker has no /lib/ld-linux, so a glibc-2.17 link of a build script
#     would not even start there; nix's cc produces binaries that run on nix.
#
# The macOS instance of the latter is exec-constrained to macOS (a native Mach-O link needs a
# Mac) and is only ever selected when the local platform is the execution platform.
zig_cxx_toolchain(
    name = "cxx-zig-linux-x86_64",
    nix_cc = ":nix_cc",
    target = "x86_64-linux-gnu.2.17",
    zig = ":zig",
)

zig_cxx_toolchain(
    name = "cxx-zig-linux-aarch64",
    nix_cc = ":nix_cc",
    target = "aarch64-linux-gnu.2.17",
    zig = ":zig",
)

zig_cxx_toolchain(
    name = "cxx-zig-macos-aarch64",
    nix_cc = ":nix_cc",
    target = "aarch64-macos",
    zig = ":zig",
)

nix_cxx_toolchain(
    name = "cxx-nix-any",
    nix_cc = ":nix_cc",
)

nix_cxx_toolchain(
    name = "cxx-nix-macos",
    exec_compatible_with = ["prelude//os/constraints:macos"],
    nix_cc = ":nix_cc",
)

toolchain_alias(
    name = "cxx",
    actual = select({
        "@root//platforms:portable-linux": select({
            "prelude//cpu:arm64": ":cxx-zig-linux-aarch64",
            "prelude//cpu:x86_64": ":cxx-zig-linux-x86_64",
        }),
        "@root//platforms:portable-macos": ":cxx-zig-macos-aarch64",
        "DEFAULT": select({
            "DEFAULT": ":cxx-nix-any",
            "prelude//os:macos": ":cxx-nix-macos",
        }),
    }),
    visibility = ["PUBLIC"],
)

# Build scripts and rustc itself are driven through small python scripts in the prelude. The
# prelude reaches this toolchain through a nested one (rust/tools:internal_tools_toolchain), and
# nested toolchains pick their execution platform on their own -- first compatible -- rather than
# following the consumer. Consumers of the macOS-constrained C toolchain above (macOS target,
# not portable, i.e. a local build) would otherwise be handed a Linux python; selecting a
# macOS-constrained instance for exactly that configuration makes the two resolutions agree.
# Portable targets resolve wherever their zig link does, so they take the unconstrained one.
nix_python_bootstrap_toolchain(
    name = "python_bootstrap-any",
    python = ":python",
)

nix_python_bootstrap_toolchain(
    name = "python_bootstrap-macos",
    exec_compatible_with = ["prelude//os/constraints:macos"],
    python = ":python",
)

toolchain_alias(
    name = "python_bootstrap",
    actual = select({
        "@root//platforms:portable-linux": ":python_bootstrap-any",
        "@root//platforms:portable-macos": ":python_bootstrap-any",
        "DEFAULT": select({
            "DEFAULT": ":python_bootstrap-any",
            "prelude//os:macos": ":python_bootstrap-macos",
        }),
    }),
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)
