# Target platforms for mccrypt, one per slot in native/src/main/resources. The prelude's
# system_rust_toolchain turns the os/cpu constraints into rustc's --target, and toolchains//:cxx
# selects the zig cross-linker for the Linux ones.
#
#   buck2 build '//mccrypt:mccrypt[cdylib]' --target-platforms //platforms:linux-x86_64
#
# //mccrypt:cdylib-<slot> pins the cdylib to each of these, and //native:lib packs all three.

platform(
    name = "linux-x86_64",
    constraint_values = [
        "prelude//os/constraints:linux",
        "prelude//cpu/constraints:x86_64",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "linux-aarch64",
    constraint_values = [
        "prelude//os/constraints:linux",
        "prelude//cpu/constraints:arm64",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "macos-arm64",
    constraint_values = [
        "prelude//os/constraints:macos",
        "prelude//cpu/constraints:arm64",
    ],
    visibility = ["PUBLIC"],
)
