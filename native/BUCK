load("@jvm//rules:java.bzl", "jar_assembly", "java_library", "java_test")
load("//third-party/jvm:classpaths.bzl", "CLASSPATHS")

# velocity-native, in two targets on purpose: :lib is the classes plus the checked-in natives,
# and is what //proxy:lib compiles against; :jar adds the cipher slots buck2 builds itself and
# is what the shipped jar bundles. Compiling against :jar would put every javac behind the whole
# rust chain (proc macro, jni-sys, three cdylib links) for resources that javac never reads.
#
# The cipher slots Natives.java tries first ("/<platform>/velocity-cipher.*") are filled from
# buck2's own mccrypt builds rather than from the files checked in under src/main/resources --
# those stay as they are for gradle, and the buck2 jar always carries the cdylibs built from the
# mccrypt sources in this tree, for all three platforms, whatever host it is built on.
MCCRYPT_SLOTS = {
    "linux_aarch64/velocity-cipher.so": "//mccrypt:cdylib-linux_aarch64[cdylib]",
    "linux_x86_64/velocity-cipher.so": "//mccrypt:cdylib-linux_x86_64[cdylib]",
    "macos_arm64/velocity-cipher.dylib": "//mccrypt:cdylib-macos_arm64[cdylib]",
}

java_library(
    name = "lib",
    srcs = glob(["src/main/java/**/*.java"]),
    resources = {"src/main/resources": glob(
        ["src/main/resources/**"],
        exclude = ["src/main/resources/" + slot for slot in MCCRYPT_SLOTS],
    )},
    deps = CLASSPATHS["velocity-native"]["compileClasspath"],
    visibility = ["PUBLIC"],
)

jar_assembly(
    name = "jar",
    inputs = [":lib"],
    resource_files = MCCRYPT_SLOTS,
    visibility = ["PUBLIC"],
)

# Against :jar rather than :lib: these tests load the native cipher out of the jar's
# resources, and :jar is the one carrying the mccrypt cdylibs this tree builds.
java_library(
    name = "test-lib",
    srcs = glob(["src/test/java/**/*.java"]),
    deps = [":jar"] + CLASSPATHS["velocity-native"]["testRuntimeClasspath"],
)

java_test(
    name = "test",
    main_class = "org.junit.platform.console.ConsoleLauncher",
    # `buck2 test //...` otherwise drags in the prelude's own trivially-passing targets (every
    # reindeer .crate download carries ExternalRunnerTestInfo); --include junit selects ours.
    labels = ["junit"],
    deps = [":test-lib", ":jar"] + CLASSPATHS["velocity-native"]["testRuntimeClasspath"],
    args = [
        "execute",
        "--scan-classpath=$(location :test-lib)",
        "--fail-if-no-tests",
        "--disable-ansi-colors",
        "--details=summary",
    ],
)
