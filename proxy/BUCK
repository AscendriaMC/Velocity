load("@jvm//rules:java.bzl", "jar_assembly", "java_library")
load("//third-party/jvm:classpaths.bzl", "CLASSPATHS")

# velocity-proxy, compiled. Not yet the shaded jar: no relocation, no log4j plugin-cache
# merge, no manifest, no configurate3 bundle -- see proxy/build.gradle.kts for what shadowJar
# still does on top of this.
java_library(
    name = "lib",
    srcs = glob(["src/main/java/**/*.java"]),
    resources = {"src/main/resources": glob(["src/main/resources/**"])},
    deps = ["//api:lib", "//native:lib"] + CLASSPATHS["velocity-proxy"]["compileClasspath"],
    processors = CLASSPATHS["velocity-proxy"]["annotationProcessor"],
    # Same -A flags upstream passes: log4j's GraalVmProcessor names its reflect-config by them.
    processor_options = {
        "log4j.graalvm.groupId": "com.velocitypowered",
        "log4j.graalvm.artifactId": "velocity-proxy",
    },
    visibility = ["PUBLIC"],
)

# The shipped proxy jar, what shadowJar produces in gradle. Same relocation, exclusion and log4j
# plugin-cache merge; on top of that META-INF/services are merged rather than first-wins (gradle
# silently keeps only the first jar's providers) and module-info.class files are dropped.
#
# Implementation-Version comes from gradle.properties, the one place the version is written --
# unless the build was invoked with `-c velocity.implementation_version=...`, which is how
# `just release` stamps the revision in. Stamping through config rather than by running jj/git in
# an action keeps every step but this last one cacheable across revisions, and the developer
# build reproducible.
IMPLEMENTATION_VERSION = read_root_config("velocity", "implementation_version", "")

jar_assembly(
    name = "all",
    inputs = [":lib", "//api:lib", "//native:jar"]
        + CLASSPATHS["velocity-proxy"]["runtimeClasspath"]
        + ["//proxy/deprecated/configurate3:configurate3"],
    relocations = {"org.bstats": "com.velocitypowered.proxy.bstats"},
    excludes = ["org/checkerframework/checker/**"],
    merges = {
        "META-INF/services/**": "services",
        "META-INF/org/apache/logging/log4j/core/config/plugins/Log4j2Plugins.dat": "log4j2-plugin-cache",
    },
    main_class = "com.velocitypowered.proxy.Velocity",
    manifest = {
        "Implementation-Title": "Velocity",
        "Implementation-Vendor": "Velocity Contributors",
        "Multi-Release": "true",
        "Enable-Native-Access": "ALL-UNNAMED",
    } | ({"Implementation-Version": IMPLEMENTATION_VERSION} if IMPLEMENTATION_VERSION else {}),
    manifest_from_properties = {} if IMPLEMENTATION_VERSION else {
        "Implementation-Version": ("//:gradle.properties", "version"),
    },
    visibility = ["PUBLIC"],
)
