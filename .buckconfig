[cells]
  root = .
  prelude = prelude
  toolchains = toolchains
  none = none
  # The JVM rules + the jar assembly tool. Written to be lifted out into their own repository
  # (and consumed as an external cell) -- nothing in jvm// may load from root// or prelude//.
  jvm = jvm

# The prelude that ships inside the buck2 binary. It is what reindeer's generated rules
# (cargo.rust_library, buildscript_run, http_archive) are written against; the java rules in
# bzl/ do not use it, but they run fine on its platforms.
[external_cells]
  prelude = bundled

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  buck = none

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default

[build]
  execution_platforms = prelude//platforms:default

[rust]
  default_edition = 2021
  remap_src_paths = yes

[project]
  # Top-level entries only -- that is all this buck2 prunes (see season-two's note on the same
  # key). Gradle's per-module build/ dirs are not declared inputs, so their churn is noise, not
  # rebuilds.
  ignore = .jj, .git, .direnv, .gradle, .gradle-home, build, buck-out, dist, .idea, mccrypt/target

[buck2]
  file_watcher = notify
