[cells]
  root = .
  prelude = prelude
  toolchains = toolchains
  none = none
  # The JVM rules + the jar assembly tool. Written to be lifted out into their own repository
  # (and consumed as an external cell) -- nothing in jvm// may load from root// or prelude//.
  jvm = jvm
  # buck2.nix: tools as flake packages, realised by `nix build` wherever the action runs. See
  # third-party/buck2.nix/NOTICE.md for why it is vendored.
  nix = third-party/buck2.nix

# The prelude that ships inside the buck2 binary. It is what reindeer's generated rules
# (cargo.rust_library, buildscript_run, http_archive) are written against; the java rules in
# bzl/ do not use it, but they run fine on its platforms.
[external_cells]
  prelude = bundled

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  buck = none

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default

[test]
  # One result per test instead of one per target: the executor asks a junit-typed command for its
  # XML report and reports every <testcase> it finds (jvm/tools/junit-runner). Anything else --
  # including the prelude's own targets -- is reported from its exit code, as buck2 would.
  # Built with `just test-runner`; plain buck2, no patched binary.
  # A bare name, not a path: buck2 hands it to the daemon as-is, and the daemon's cwd is not the
  # project root, so a relative path never resolves. With no separators it is a PATH lookup
  # instead, and .envrc puts the built binary there. `just test-runner` builds it.
  v2_test_executor = junit-runner

[build]
  # platforms/BUCK: local, plus remote workers when `-c re.enabled=true`.
  execution_platforms = root//platforms:execution

# Remote execution: optional, and entirely per-checkout. The workers are expected to have nothing
# on them but nix -- every tool an action needs comes from nix/flake.nix. Both halves live in
# .buckconfig.local, which is not committed: `[re] enabled = true` to turn it on, and a
# `[buck2_re_client]` section with engine_address / action_cache_address / cas_address (plus tls
# and instance_name) pointing at your own instance. A plain build never touches the network.

[rust]
  default_edition = 2021
  remap_src_paths = yes

[project]
  # Top-level entries only -- that is all this buck2 prunes (see season-two's note on the same
  # key). Gradle's per-module build/ dirs are not declared inputs, so their churn is noise, not
  # rebuilds.
  ignore = .jj, .git, .direnv, .gradle, .gradle-home, build, buck-out, dist, .idea, mccrypt/target, jvm/tools/junit-runner/target

[buck2]
  file_watcher = notify
  # What the RE protocol speaks; also what the workers' nix-built tools are keyed by upstream.
  digest_algorithms = SHA256
